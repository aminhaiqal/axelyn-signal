# PostgreSQL — these defaults are for local Docker only. Change the password on a VPS.
POSTGRES_USER=axelyn
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=axelyn_signal
POSTGRES_PORT=5432

# Used when running the app outside Docker. Compose supplies PGHOST/PGUSER/etc directly.
DATABASE_URL=postgresql://axelyn:replace_me@localhost:5432/axelyn_signal
DATABASE_SSL=false
PG_POOL_MAX=5

# Required to encrypt web-managed credentials. Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# Application
APP_PORT=3000
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Axelyn Signal

# Conservative defaults for running beside other workloads on a VPS.
APP_CPUS=1.0
APP_MEMORY_LIMIT=1g
DB_CPUS=0.75
DB_MEMORY_LIMIT=768m
TUNNEL_CPUS=0.25
TUNNEL_MEMORY_LIMIT=256m

# OpenRouter credentials are saved in the web app and encrypted in PostgreSQL.
# Swap any model without changing application code.
SCOUT_MODEL=google/gemini-2.5-flash-lite
EXPLORER_MODEL=google/gemini-2.5-flash
CRITIC_MODEL=deepseek/deepseek-v3.2
STRATEGIST_MODEL=anthropic/claude-haiku-4.5

SCOUT_TEMPERATURE=0.2
EXPLORER_TEMPERATURE=0.75
CRITIC_TEMPERATURE=0.25
STRATEGIST_TEMPERATURE=0.3

SCOUT_MAX_OUTPUT_TOKENS=1600
EXPLORER_MAX_OUTPUT_TOKENS=5200
CRITIC_MAX_OUTPUT_TOKENS=5200
STRATEGIST_MAX_OUTPUT_TOKENS=6200

# Per-token fallback prices used only if OpenRouter does not return usage.cost.
SCOUT_INPUT_PRICE=0.0000001
SCOUT_OUTPUT_PRICE=0.0000004
EXPLORER_INPUT_PRICE=0.0000003
EXPLORER_OUTPUT_PRICE=0.0000025
CRITIC_INPUT_PRICE=0.000000269
CRITIC_OUTPUT_PRICE=0.0000004
STRATEGIST_INPUT_PRICE=0.000001
STRATEGIST_OUTPUT_PRICE=0.000005

# Optional: enables the cloudflared Compose profile after a tunnel is created.
CLOUDFLARE_TUNNEL_TOKEN=
